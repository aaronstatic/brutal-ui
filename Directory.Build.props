<Project>

  <!-- Language and target settings. Every project uses them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <!-- Warning policy. A warning fails the build. The audit warnings stay warnings.
       NU1900 means the audit source is not reachable. NU1901 to NU1904 report advisories.
       A new advisory or a network failure must not break the build of an unchanged commit. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- Packaging default. Only the library projects in src/ become packages. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pack metadata. Every package shares the version, the authors, and the licence. -->
  <PropertyGroup>
    <Version>0.1.0-alpha</Version>
    <Authors>Aaron Static</Authors>
    <Copyright>Copyright (c) 2026 Aaron Static</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/aaronstatic/brutal-ui</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
  </PropertyGroup>

  <!-- Test runner. Test projects use Microsoft.Testing.Platform. -->
  <PropertyGroup>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

</Project>
