<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Keep the restore inside this feed set, whatever the machine or solution config adds. -->
    <clear />
    <!-- Local feed: the packed BrutalUi packages from artifacts/packages. -->
    <add key="local" value="../../artifacts/packages" />
    <!-- Public feed: the BRUTAL Ahwoo packages and the .NET runtime packages. -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <!-- One feed per id pattern. The mapping stops NU1507, which central package management would report for two sources. -->
    <packageSource key="local">
      <package pattern="BrutalUi.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
