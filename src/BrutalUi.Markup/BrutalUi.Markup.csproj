<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The XML element loader and the stylesheet parser for brutal-ui.</Description>
  </PropertyGroup>

  <!-- The test project reads the internal parser types: the tokens and the tokenizer. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BrutalUi.Markup.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BrutalUi.Core/BrutalUi.Core.csproj" />
  </ItemGroup>

  <!-- The generator runs on the declarations of Markup, and the pack puts it in analyzers/dotnet/cs. -->
  <ItemGroup>
    <ProjectReference Include="../BrutalUi.Generators/BrutalUi.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../BrutalUi.Generators/bin/$(Configuration)/netstandard2.0/BrutalUi.Generators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
