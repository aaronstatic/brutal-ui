<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Element tree, layout, style, input, and the renderer interface for brutal-ui. No ImGui reference.</Description>
    <!-- This value repeats the value of src/Directory.Build.props on purpose. The project file shows that the build enforces the doc comments. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The test project reads the internal tree types: the storage, the dirty bits, and the walk. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BrutalUi.Core.Tests" />
  </ItemGroup>

  <!-- The adapter tests of BrutalUi.Glfw call the drain and read the last hit. DrainEvents stays internal until routing-gate. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BrutalUi.Glfw.Tests" />
  </ItemGroup>

  <!-- The layout engine is a port of Yoga (MIT). The package carries the Yoga notice at its root. -->
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" />
    <PackageReference Include="Ahwoo.BRUTAL.Localization" />
  </ItemGroup>

</Project>
