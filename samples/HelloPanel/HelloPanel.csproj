<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BrutalUi.Core/BrutalUi.Core.csproj" />
    <ProjectReference Include="../../src/BrutalUi.Framework/BrutalUi.Framework.csproj" />
    <ProjectReference Include="../../src/BrutalUi.Glfw/BrutalUi.Glfw.csproj" />
    <ProjectReference Include="../../src/BrutalUi.ImGui/BrutalUi.ImGui.csproj" />
    <ProjectReference Include="../../src/BrutalUi.Markup/BrutalUi.Markup.csproj" />
    <!-- The generator runs on the marked sample types. An analyzer from a ProjectReference does not flow on. -->
    <ProjectReference Include="../../src/BrutalUi.Generators/BrutalUi.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="HelloScreen.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HelloState.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="HelloDefinitions.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
